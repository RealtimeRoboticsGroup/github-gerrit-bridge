module(name = "github_gerrit_bridge")

bazel_dep(name = "rules_go", version = "0.64.1")
bazel_dep(name = "gazelle", version = "0.54.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.2")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "in_gopkg_yaml_v3", "org_golang_x_crypto")

# A local Gerrit for integration tests and manual testing (//cmd/testgerrit).

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file(
    name = "gerrit_war",
    downloaded_file_path = "gerrit.war",
    sha256 = "fac0065c142590414a31ee137f4c9f668e52766d4c114c4eb57037adf48d46a7",
    urls = ["https://gerrit-releases.storage.googleapis.com/gerrit-3.14.4.war"],
)

http_archive(
    name = "temurin21",
    build_file_content = """
filegroup(
    name = "jdk",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files(["bin/java"])
""",
    sha256 = "ce79869e1307ed8ee1e2baa86a412b1eb5b75d10a01006d788a6f968bcfaee94",
    strip_prefix = "jdk-21.0.12.1+1",
    urls = ["https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1/OpenJDK21U-jdk_x64_linux_hotspot_21.0.12.1_1.tar.gz"],
)

# The container image (//image), for running the bridge in Kubernetes.

bazel_dep(name = "rules_oci", version = "2.3.5")
bazel_dep(name = "rules_pkg", version = "1.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# The base: Debian trixie with git, which the bridge runs for its mirror
# (and ssh, for git with a peer key), and CA certificates.  Pinned by
# digest; mirror.gcr.io is Google's mirror of Docker Hub.
oci.pull(
    name = "buildpack_deps_scm",
    # buildpack-deps:trixie-scm, 2026-11-22
    digest = "sha256:4f34e1d673fdb65371de9f88bdd32c4e30152fe692b35604aef5c0b3c0e6da10",
    image = "mirror.gcr.io/library/buildpack-deps",
    platforms = ["linux/amd64"],
)
use_repo(oci, "buildpack_deps_scm", "buildpack_deps_scm_linux_amd64")
