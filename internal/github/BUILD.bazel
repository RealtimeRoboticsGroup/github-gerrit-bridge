load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "github",
    srcs = [
        "client.go",
        "graphql.go",
        "pulls.go",
        "reviews.go",
        "stacks.go",
        "token.go",
        "userauth.go",
        "webhook.go",
    ],
    importpath = "github.com/AustinSchuh/github-gerrit-bridge/internal/github",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/trace"],
)

go_test(
    name = "github_test",
    srcs = [
        "client_test.go",
        "userauth_test.go",
        "webhook_test.go",
    ],
    embed = [":github"],
    deps = ["//internal/trace"],
)
