[project]
	description = Access inherited by all other projects.
[receive]
	requireContributorAgreement = false
	requireSignedOffBy = false
	requireChangeId = true
	enableSignedPush = false
[submit]
	mergeContent = true
[access "refs/*"]
	read = group Administrators
[access "refs/for/*"]
	addPatchSet = group Registered Users
[access "refs/for/refs/*"]
	push = group Registered Users
	pushMerge = group Registered Users
[access "refs/heads/*"]
	create = group Administrators
	create = group Project Owners
	create = group Submitters
	editTopicName = +force group Administrators
	editTopicName = +force group Project Owners
	forgeAuthor = group Forge Author
	forgeAuthor = group Sudo
	forgeCommitter = group Administrators
	forgeCommitter = group Project Owners
	forgeCommitter = group Sudo
	label-Code-Review = -2..+2 group Administrators
	label-Code-Review = -2..+2 group Project Owners
	label-Code-Review = -2..+2 group Verified Users
	label-Code-Review = -1..+1 group Registered Users
	push = group Administrators
	push = group Project Owners
	push = +force group Sudo
	read = group Registered Users
	read = block group Anonymous Users
	revert = group Registered Users
	submit = group Administrators
	submit = group Project Owners
	submit = group Submitters
	forgeServerAsCommitter = group Sudo
	pushMerge = group Sudo
[access "refs/meta/config"]
	exclusiveGroupPermissions = read
	create = group Administrators
	create = group Project Owners
	label-Code-Review = -2..+2 group Administrators
	label-Code-Review = -2..+2 group Project Owners
	push = group Administrators
	push = group Sudo
	read = group Administrators
	read = group Project Owners
	submit = group Administrators
	submit = group Sudo
[access "refs/meta/version"]
	read = group Anonymous Users
[access "refs/tags/*"]
	create = group Administrators
	create = group Project Owners
	create = group Submitters
	createSignedTag = group Administrators
	createSignedTag = group Project Owners
	createSignedTag = group Submitters
	createTag = group Administrators
	createTag = group Project Owners
	createTag = group Submitters
[label "Code-Review"]
	function = MaxWithBlock
	defaultValue = 0
	value = -2 This shall not be submitted
	value = -1 I would prefer this is not submitted as is
	value = 0 No score
	value = +1 Looks good to me, but someone else must approve
	value = +2 Looks good to me, approved
	copyCondition = changekind:NO_CHANGE OR changekind:TRIVIAL_REBASE OR is:MIN
[access "refs/heads/unreviewed/${username}/*"]
	create = group Verified Users
	createSignedTag = group Verified Users
	createTag = group Verified Users
	delete = group Verified Users
	deleteChanges = group Verified Users
	deleteOwnChanges = group Verified Users
	forgeAuthor = group Verified Users
	forgeCommitter = group Verified Users
	forgeServerAsCommitter = group Verified Users
	push = +force group Verified Users
[capability]
	administrateServer = group Administrators
	priority = batch group Service Users
	streamEvents = group Service Users
